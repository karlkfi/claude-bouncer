.context/

# Scratch output. A session's own scratchpad is the first choice — Claude Code
# picks the path and cleans it up. This is the fallback for scratch that has to
# outlive the session, and it exists so a stray file can't ride into a commit.
tmp/

# Python bytecode cache (generated by running the test suite)
__pycache__/
*.pyc

# Claude Code — local runtime artifacts (keep settings.json / commands / agents / skills / hooks tracked)
.claude/.credentials.json
.claude/scheduled_tasks.lock
.claude/shell-snapshots/
.claude/history.jsonl
.claude/todos/
.claude/tasks/
.claude/projects/
.claude/sessions/
.claude/session-env/
.claude/cache/
.claude/telemetry/
.claude/backups/
.claude/downloads/
